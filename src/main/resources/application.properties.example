spring.application.name=web-ban-hoa
spring.profiles.active=prod

# Supabase PostgreSQL
spring.datasource.url=jdbc:postgresql://YOUR_SUPABASE_HOST:5432/postgres?sslmode=require
spring.datasource.username=postgres
spring.datasource.password=YOUR_PASSWORD
spring.datasource.driver-class-name=org.postgresql.Driver

spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true

spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
spring.flyway.baseline-on-migrate=true

spring.h2.console.enabled=false

server.error.include-message=always
server.error.include-stacktrace=never

security.admin-role-header=X-Role

# Cloudflare R2 Storage (optional)
r2.enabled=false
r2.account-id=
r2.access-key=
r2.secret-key=
r2.bucket=
r2.region=auto
r2.public-base-url=

# VietQR Payment Gateway
payments.vietqr.api-base-url=https://api.vietqr.io
payments.vietqr.client-id=YOUR_CLIENT_ID
payments.vietqr.api-key=YOUR_API_KEY
payments.vietqr.webhook-secret=
payments.vietqr.signing-secret=

# SePay Payment Gateway
payments.sepay.api-base-url=https://my.sepay.vn/userapi
payments.sepay.api-token=YOUR_API_TOKEN
payments.sepay.webhook-secret=YOUR_WEBHOOK_SECRET
payments.sepay.signing-secret=

# Bank Account Information
payments.bank.account-expected=YOUR_ACCOUNT_NUMBER
payments.bank.account-number=YOUR_ACCOUNT_NUMBER
payments.bank.account-name=YOUR_ACCOUNT_NAME
payments.bank.name=YOUR_BANK_NAME
payments.bank.bin=YOUR_BANK_BIN

# Payment Configuration
payments.qr.expiry-minutes=15
payments.polling-interval-seconds=15
payments.reminder-interval-seconds=30
payments.amount-tolerance=1000

# Webhook Security
payments.webhook.ip-whitelist=127.0.0.1,::1,::ffff:127.0.0.1
payments.webhook.timestamp-tolerance-minutes=5
payments.webhook.future-tolerance-minutes=1
