# Active Spring profile: dev | prod
SPRING_PROFILES_ACTIVE=prod

# Supabase PostgreSQL connection (used in prod profile)
# Copy exact values from Supabase Dashboard -> Connect -> Session pooler or Direct connection.
# Example (session pooler):
# SUPABASE_DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# SUPABASE_DB_USER=postgres.your_project_ref
SUPABASE_DB_URL=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# Optional runtime port
SERVER_PORT=8080
