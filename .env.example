# Database (Supabase PostgreSQL)
DB_URL=jdbc:postgresql://YOUR_SUPABASE_HOST:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=YOUR_DB_PASSWORD

# Security
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Gmail SMTP (Forgot Password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=yourgmail@gmail.com
MAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD
MAIL_FROM=yourgmail@gmail.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
PASSWORD_RESET_CODE_EXPIRY_MINUTES=10

# JWT Configuration (Supabase)
JWT_SECRET=YOUR_JWT_SECRET_BASE64
JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
JWT_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_AUTH_BASE_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Cloudflare R2 Storage
R2_ENABLED=true
R2_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID
R2_ACCESS_KEY=YOUR_R2_ACCESS_KEY
R2_SECRET_KEY=YOUR_R2_SECRET_KEY
R2_BUCKET=YOUR_BUCKET_NAME
R2_REGION=auto
R2_PUBLIC_BASE_URL=

# VietQR Payment Gateway
VIETQR_API_BASE_URL=https://api.vietqr.io
VIETQR_CLIENT_ID=YOUR_VIETQR_CLIENT_ID
VIETQR_API_KEY=YOUR_VIETQR_API_KEY
# Leave these blank unless VietQR explicitly gives you webhook secrets/signing secrets.
VIETQR_WEBHOOK_SECRET=
VIETQR_SIGNING_SECRET=

# SePay Payment Gateway
SEPAY_API_BASE_URL=https://my.sepay.vn/userapi
SEPAY_API_TOKEN=YOUR_SEPAY_API_TOKEN
# Configure SePay webhook auth as API Key and paste the same key here.
SEPAY_WEBHOOK_SECRET=YOUR_SEPAY_WEBHOOK_API_KEY
SEPAY_SIGNING_SECRET=

# Bank Account Info
BANK_ACCOUNT_EXPECTED=YOUR_BANK_ACCOUNT
BANK_ACCOUNT_NUMBER=YOUR_BANK_ACCOUNT
BANK_ACCOUNT_NAME=YOUR_ACCOUNT_NAME
BANK_NAME=YOUR_BANK_NAME
BANK_BIN=YOUR_BANK_BIN

# Payment Settings
PAYMENT_QR_EXPIRY_MINUTES=15
PAYMENT_POLLING_INTERVAL=5
PAYMENT_REMINDER_INTERVAL=30
PAYMENT_AMOUNT_TOLERANCE=0

# Webhook Security
WEBHOOK_IP_WHITELIST=127.0.0.1,::1,::ffff:127.0.0.1,172.236.138.20,172.233.83.68,171.244.35.2,151.158.108.68,151.158.109.79,103.255.238.139
WEBHOOK_TIMESTAMP_TOLERANCE=5
WEBHOOK_FUTURE_TOLERANCE=1
